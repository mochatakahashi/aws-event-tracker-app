# Local Admin Account Password (for local development via `npm run dev`)
VITE_LOCAL_ADMIN_PASSWORD=your_local_admin_password

# Gmail SMTP Credentials (used for email notifications)
GMAIL_USER=aws.apcofficial@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Admin Notification Inbox
ADMIN_NOTIFY_EMAIL=aws.apcofficial@gmail.com

# AWS / DynamoDB configuration
# APP_AWS_REGION=ap-southeast-1
# APP_AWS_ACCESS_KEY_ID=
# APP_AWS_SECRET_ACCESS_KEY=
# DYNAMODB_TABLE_NAME=aws_events
# AWS_S3_BUCKET_NAME=           # banners, photos and certificates/<eventId>/<id>.pdf

# Deployed app only (set in Vercel → Settings → Environment Variables)
# ADMIN_PASSWORD=               # first password for awsapc.admin
# CRON_SECRET=                  # protects the daily reminder job
# APP_URL=https://apcsbg.org

# Amazon SES (domain apcsbg.org verified in ap-southeast-1)
# SES_FROM_EMAIL="AWS SBG-APC <notifications@apcsbg.org>"
# SES_REGION=ap-southeast-1
# SES_ACCESS_KEY_ID=            # send-only IAM user (keep separate from APP_AWS_*)
# SES_SECRET_ACCESS_KEY=
# EMAIL_PROVIDER=ses            # ses | gmail (unset: Gmail when set up, else SES)
